<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cart</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-[#f6f3ed] text-[#17202a]">

    <%- include('includes/nav.ejs') %>

    <section class="bg-[#101820] px-4 py-7 text-center text-white">
        <p class="text-sm font-bold uppercase tracking-[4px] text-[#d8b77a]">
            Your Collection
        </p>

        <h1 class="mt-1 text-3xl font-bold md:text-4xl">
            Shopping <span class="text-[#d8b77a]">Cart</span>
        </h1>

        <p class="mx-auto mt-1 max-w-xl text-white/55">
            All your favourite books in one place.
        </p>
    </section>

    <main class="mx-auto max-w-6xl px-6 py-10">

        <div class="mb-8 flex items-end justify-between border-b border-[#ded7ca] pb-5">
            <div>
                <p class="text-sm font-bold uppercase tracking-[3px] text-[#a47c43]">
                    Your Selection
                </p>

                <h2 class="mt-2 text-3xl font-bold">
                    My Books
                </h2>
            </div>

            <div class="flex items-center gap-3">
                <button onclick="clearCart()"
                    class="rounded-full border border-[#ded7ca] bg-white px-5 py-2 text-sm font-semibold transition duration-300 hover:bg-[#d8b77a]">
                    Clear Cart
                </button>

                <a href="/categories"
                    class="rounded-full border border-[#ded7ca] bg-white px-5 py-2 text-sm font-semibold transition duration-300 hover:bg-[#d8b77a]">
                Continue Shopping →
                </a>
            </div>

        </div>

        <div id="cartItems"
            class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
        </div>

        <div id="emptyCart"
            class="hidden rounded-3xl border border-[#e4ddd0] bg-white px-3 py-7 text-center shadow-sm">

            <div class="text-6xl">📚</div>

            <h2 class="mt-3 text-2xl font-bold">
                Your Cart Is Empty
            </h2>

            <p class="mt-3 text-gray-500">
                Discover your next favourite book.
            </p>

            <a href="/categories"
                class="mt-3 inline-block rounded-full bg-[#17202a] px-3 py-2 font-semibold text-white transition duration-300 hover:bg-[#d8b77a] hover:text-[#101820]">
                Explore Categories →
            </a>
        </div>

        <div id="cartSummary"
            class="mt-8 hidden rounded-3xl bg-[#17202a] p-6 text-white shadow-xl">

                Order Summary
            </p>

            <div class="mt-2 flex items-center justify-between border-b border-white/10 pb-2">
                <span class="text-white/60">Total Items</span>
                <span id="totalItems" class="font-semibold">0</span>
            </div>

            <div class="mt-2 flex items-center justify-between">
                <span class="text-lg font-semibold">Total Amount</span>
                <span id="totalPrice" class="text-2xl font-bold text-[#d8b77a]">
                    ₹0.00
                </span>
            </div>

            <button onclick="checkout()"
                class="mt-6 w-full rounded-xl bg-[#d8b77a] py-2 font-bold text-[#101820] transition duration-300 hover:bg-[#f0d59e]">
                Proceed to Checkout →
            </button>
        </div>

    </main>

     <footer class="bg-[#101820] px-6 py-5 text-white md:px-10">
        <div class="mx-auto grid max-w-6xl gap-8 text-center md:grid-cols-2 md:items-center md:text-left">

            <div>
                <h3 class="text-2xl font-bold">
                    The <span class="font-serif italic text-[#d8b77a]">Book Store</span>
                </h3>

                <p class="mt-4 max-w-md text-lg leading-6 text-white/45">
                    A place where stories come alive, knowledge grows
                    and every reader can find something special.
                </p>
            </div>

            <div class="md:text-right">
                <p class="text-lg font-bold text-[#d8b77a]">
                    Read. Learn. Grow.
                </p>

                <p class="mt-2 text-lg text-white/45">
                    © The Book Store
                </p>
            </div>

        </div>
    </footer>


    <script>
        function getCart() {
            try {
                const cart = JSON.parse(localStorage.getItem('cart')) || [];
                return Array.isArray(cart) ? cart : [];
            } catch (error) {
                return [];
            }
        }

        function saveCart(cart) {
            localStorage.setItem('cart', JSON.stringify(cart));
        }

        function escapeHTML(value) {
            return String(value ?? '').replace(/[&<>"']/g, function (char) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                }[char];
            });
        }

        function renderCart() {
            const cart = getCart();
            const cartItems = document.getElementById('cartItems');
            const emptyCart = document.getElementById('emptyCart');
            const cartSummary = document.getElementById('cartSummary');

            cartItems.innerHTML = '';

            if (cart.length === 0) {
                emptyCart.classList.remove('hidden');
                cartSummary.classList.add('hidden');
                return;
            }

            emptyCart.classList.add('hidden');
            cartSummary.classList.remove('hidden');

            let totalItems = 0;
            let totalPrice = 0;

            cart.forEach((book, index) => {
                const price = Number(book.price) || 0;
                const quantity = Math.max(1, Number(book.quantity) || 1);

                totalItems += quantity;
                totalPrice += price * quantity;

                const image = book.image || 
                    'https://placehold.co/400x500/f0e6d3/17202a?text=Book+Cover';

                cartItems.innerHTML += `
                    <div class="group overflow-hidden rounded-3xl border border-[#e4ddd0] bg-white shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-2xl">

                        <div class="flex h-64 items-center justify-center overflow-hidden bg-[#f0e6d3]">
                            <img
                                src="${escapeHTML(image)}"
                                alt="${escapeHTML(book.title)}"
                                class="h-full w-full object-contain p-4 transition duration-500 group-hover:scale-105"
                                onerror="this.onerror=null;this.src='https://placehold.co/400x500/f0e6d3/17202a?text=Book+Cover';"
                            >
                        </div>

                        <div class="p-3">

                            <div class="mb-3 flex items-start justify-between">
                                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#f0e6d3] text-1xl">
                                    📖
                                </div>

                                <span class="rounded-full bg-[#f6f3ed] px-3 py-2 text-xs font-semibold text-[#a47c43]">
                                    ${escapeHTML(book.category || 'Book')}
                                </span>
                            </div>

                            <h2 class="text-xl font-bold text-[#17202a]">
                                ${escapeHTML(book.title)}
                            </h2>

                            <div class="mt-4 space-y-3">

                                <div class="flex items-center justify-between border-b border-[#eee9df] pb-1">
                                    <span class="text-sm text-gray-400">Author</span>
                                    <span class="max-w-[60%] text-right text-sm font-semibold">
                                        ${escapeHTML(book.author || 'Unknown')}
                                    </span>
                                </div>

                                <div class="flex items-center justify-between border-b border-[#eee9df] pb-1">
                                    <span class="text-sm text-gray-400">Price</span>
                                    <span class="text-xl font-bold text-[#a47c43]">
                                        ₹${price.toFixed(2)}
                                    </span>
                                </div>

                                <div class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400">Quantity</span>

                                    <div class="flex items-center gap-3">
                                        <button
                                            onclick="changeQuantity(${index}, -1)"
                                            class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#f0e6d3] font-bold hover:bg-[#d8b77a]">
                                            −
                                        </button>

                                        <span class="font-bold">${quantity}</span>

                                        <button
                                            onclick="changeQuantity(${index}, 1)"
                                            class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#f0e6d3] font-bold hover:bg-[#d8b77a]">
                                            +
                                        </button>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-1">
                                    <span class="text-sm text-gray-400">Subtotal</span>
                                    <span class="font-bold text-[#a47c43]">
                                        ₹${(price * quantity).toFixed(2)}
                                    </span>
                                </div>

                            </div>

                            <button
                                onclick="removeBook(${index})"
                                class="mt-4 w-full rounded-xl bg-[#17202a] py-2 font-semibold text-white transition duration-300 hover:bg-[#d8b77a] hover:text-[#101820]">
                                Remove Book ×
                            </button>

                        </div>
                    </div>
                `;
            });

            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('totalPrice').textContent =
                '₹' + totalPrice.toFixed(2);
        }

        function changeQuantity(index, amount) {
            const cart = getCart();

            if (!cart[index]) return;

            const quantity = Math.max(1, Number(cart[index].quantity) || 1);
            cart[index].quantity = quantity + amount;

            saveCart(cart);
            renderCart();
        }

        function removeBook(index) {
            const cart = getCart();

            cart.splice(index, 1);

            saveCart(cart);
            renderCart();
        }

        function clearCart() {
            if (getCart().length === 0) return;

            if (confirm('Are you sure you want to clear your cart?')) {
                saveCart([]);
                renderCart();
            }
        }

        function checkout() {
            if (getCart().length === 0) {
                alert('Your cart is empty.');
                return;
            }

            window.location.href = '/checkout';
        }

        renderCart();
    </script>

</body>
</html>