                alt="Our Book Store"
                class="h-120 w-full object-cover transition duration-500 hover:scale-105"
            >
        </div>

        <div class="flex flex-col justify-center rounded-2xl bg-white p-6 shadow-md">

            <h3 class="text-2xl font-bold text-[#17202a]">
                A World of Books
