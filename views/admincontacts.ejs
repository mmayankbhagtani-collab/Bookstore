<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Messages | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-[#f6f3ed] text-[#17202a]">
    <%- include('includes/nav.ejs') %>

    <header class="bg-[#101820] px-6 py-10 text-center text-white">
        <p class="text-sm font-bold uppercase tracking-[4px] text-[#d8b77a]">Admin Panel</p>
        <h1 class="mt-2 text-3xl font-bold md:text-4xl">Contact Messages</h1>
        <p class="mt-2 text-white/60">See who got in touch and how to reply.</p>
    </header>

    <main class="mx-auto max-w-5xl space-y-6 px-5 py-10">
        <% if (contacts.length === 0) { %>
            <section class="rounded-3xl border border-[#e4ddd0] bg-white px-6 py-16 text-center shadow-sm">
                <p class="text-xl font-semibold">No messages yet</p>
                <p class="mt-2 text-gray-500">Messages submitted through the Contact page will appear here.</p>
            </section>
        <% } %>

        <% contacts.forEach(contact => { %>
            <article class="overflow-hidden rounded-3xl border border-[#e4ddd0] bg-white shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3 bg-[#17202a] px-6 py-5 text-white">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[3px] text-[#d8b77a]">From</p>
                        <h2 class="mt-1 text-lg font-bold"><%= contact.name %></h2>
                    </div>
                    <p class="text-sm text-white/70">
                        Received <%= new Date(contact.createdAt).toLocaleString() %>
                    </p>
                </div>

                <div class="space-y-5 p-6">
                    <div class="flex justify-end">
                        <form action="/admin/contacts/delete/<%= contact._id %>" method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this contact message?');">
                            <button type="submit"
                                class="rounded-full border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-500 hover:text-white">
                                Delete Message
                            </button>
                        </form>
                    </div>
                    <dl class="grid gap-3 text-sm sm:grid-cols-2">
                        <div>
                            <dt class="font-semibold text-[#a47c43]">Email</dt>
                            <dd class="mt-1 break-all"><a class="underline hover:text-[#a47c43]" href="mailto:<%= contact.email %>"><%= contact.email %></a></dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-[#a47c43]">Phone</dt>
                            <dd class="mt-1"><a class="underline hover:text-[#a47c43]" href="tel:<%= contact.mobile %>"><%= contact.mobile %></a></dd>
                        </div>
                    </dl>
                    <section>
                        <h3 class="mb-2 font-semibold text-[#a47c43]">Message</h3>
                        <p class="whitespace-pre-wrap break-words rounded-xl bg-[#f6f3ed] p-4 text-sm leading-6"><%= contact.message %></p>
                    </section>
                </div>
            </article>
        <% }) %>
    </main>
</body>
</html>
